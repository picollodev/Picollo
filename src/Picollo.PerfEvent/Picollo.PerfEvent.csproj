<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PackageId>Picollo.PerfEvent</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Picollo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Picollo\Picollo.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="picollo_native.c"/>
    <None Update="picollo_native.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="CompileNativeLinux" BeforeTargets="BeforeBuild" Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))) AND $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">
    <Exec Command="bash ./build_gcc.sh"/>
    <Message Importance="High" Text="Successfully compiled picollo_native.so with -O3"/>
  </Target>

  <Target Name="CheckNativeExistsBeforePublish" BeforeTargets="BeforePublish">
    <Error Condition="!Exists('picollo_native.so')" Text="Native library picollo_native.so not found. Please compile it first on Linux x64 or provide it manually."/>
  </Target>

  <Target Name="PublishNativeLinuxAsset" BeforeTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' == 'linux-x64' and Exists('$(MSBuildProjectDirectory)/picollo_native.so')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/picollo_native.so">
        <RelativePath>picollo_native.so</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
